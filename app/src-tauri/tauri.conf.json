{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PMTool",
  "version": "2.0.0",
  "identifier": "com.pmtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PMTool · 实施经理工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/16x16@2x.png",
      "icons/24x24.png",
      "icons/24x24@2x.png",
      "icons/32x32.png",
      "icons/32x32@2x.png",
      "icons/48x48.png",
      "icons/48x48@2x.png",
      "icons/64x64.png",
      "icons/64x64@2x.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "实施经理个人工作台",
    "longDescription": "PMTool 是面向实施项目经理、交付经理、项目负责人设计的个人工作管理软件。"
  }
}